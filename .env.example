# Copy to .env and fill in. Never commit .env.
# --- LLM providers ---
ANTHROPIC_API_KEY=
# Optional: route through a Bedrock/Vertex/Foundry deployment instead of the Claude API
# (see docs/MODEL_RECOMMENDATIONS.md for data-residency / zero-retention notes)
# --- Embedding providers ---
VOYAGE_API_KEY=
OPENAI_API_KEY=
# --- App ---
FIRM_RAG_DB=./data/firm_rag.db
FIRM_RAG_UPLOADS=./data/uploads
FIRM_RAG_MODELS=./models.yaml
# Which named profile in models.yaml to use. "offline" runs with no API keys at all.
FIRM_RAG_PROFILE=offline
# Keep a copy of each uploaded original under FIRM_RAG_UPLOADS (true), or store only the index and a
# source link back to the firm's file share / DMS (false = pointer mode, no duplicate storage).
FIRM_RAG_KEEP_ORIGINALS=true
# Simple shared secret for the prototype UI/API (replace with SSO before any real deployment)
FIRM_RAG_API_TOKEN=change-me
