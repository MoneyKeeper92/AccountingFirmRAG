---
import Base from "../layouts/Base.astro";
import QuizEmbed from "../components/QuizEmbed.astro";

const faqs = [
  {
    q: "¿Es gratis?",
    a: "Sí. La beta es gratuita, sin tarjeta y sin periodo de prueba que caduque. Si algún día hay planes de pago, quienes entren ahora lo sabrán con antelación y conservarán condiciones especiales.",
  },
  {
    q: "¿Quién hace las preguntas?",
    a: "Hay dos tipos. Las preguntas de Tesón se redactan a partir del texto consolidado de la ley publicado en el BOE. Las preguntas oficiales son literales de los exámenes publicados por el INAP, con su fuente; las explicaciones son nuestras. Usamos inteligencia artificial para ayudarnos a redactar, y cada pregunta pasa por una revisión humana. Lo contamos en Metodología.",
  },
  {
    q: "¿Qué temas hay ahora mismo?",
    a: "La beta empieza con la Constitución Española: 82 preguntas redactadas por Tesón y 106 preguntas oficiales de exámenes del INAP (2022–2026), todas con la explicación de cada opción. Iremos añadiendo temas del Bloque I según lo que más pidáis.",
  },
  {
    q: "¿Estáis relacionados con el INAP o con alguna academia?",
    a: "No. Tesón es un proyecto independiente. Cuando citamos exámenes oficiales, indicamos su fuente.",
  },
  {
    q: "¿Funciona en el móvil?",
    a: "Sí. Está pensada para el móvil y puedes instalarla como app desde el navegador.",
  },
  {
    q: "¿Qué hacéis con mis datos?",
    a: "Solo lo necesario para que la plataforma funcione: tu email para entrar y tu progreso. Servidores en la UE. Los detalles están en Privacidad.",
  },
];
---
<Base
  title="Tesón · Tests de Auxiliar Administrativo del Estado con cada respuesta explicada"
  description="Practica tests de oposiciones con la explicación de cada opción y el artículo exacto del BOE. La app aprende de tus fallos y te propone lo que más necesitas mejorar. Beta gratuita."
>
  <div class="hero">
    <div class="narrow">
      <span class="eyebrow">Beta gratuita</span>
      <h1>Tu plaza, pregunta a pregunta.</h1>
      <p class="lead">Tests de Auxiliar Administrativo del Estado que se adaptan a ti, con cada respuesta explicada de forma visual.</p>
      <div class="cta-row"><a class="btn btn-primary" href="#test">Haz el test gratis</a></div>
      <p class="muted small" style="margin-top:12px">10 preguntas del examen oficial · sin registro</p>
    </div>
  </div>

  <QuizEmbed />

  <section>
    <div class="wrap">
      <h2>Por qué Tesón</h2>
      <div class="grid-3" style="margin-top:24px">
        <div class="card">
          <h3>Personalizado</h3>
          <p>Tu nivel en cada área y concepto, calculado con tus propias respuestas.</p>
        </div>
        <div class="card">
          <h3>Adaptativo</h3>
          <p>Cada sesión empieza por lo que más te cuesta. Tus fallos vuelven justo antes de que los olvides.</p>
        </div>
        <div class="card">
          <h3>Explicaciones visuales</h3>
          <p>La clave de cada pregunta en una línea, el artículo resaltado y un esquema para entenderlo de un vistazo.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="narrow">
      <h2>Preguntas frecuentes</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  })} />
</Base>
