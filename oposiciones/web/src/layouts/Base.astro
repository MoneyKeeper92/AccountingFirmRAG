---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { site, indexable, ctaHref, ctaLabel } from "../site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const robots = indexable && !noindex ? "index,follow" : "noindex,nofollow";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1F5E4A" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Tesón" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap">
        <Logo />
        <nav class="nav" aria-label="Principal">
          <a class="nav-link" href="/auxiliar-administrativo-estado/">Auxiliar Administrativo</a>
          <a class="nav-link" href="/herramientas/calculadora-nota-oposiciones/">Calculadora</a>
          <a class="nav-link" href="/metodologia/">Metodología</a>
          <a class="btn btn-primary btn-small" href={ctaHref}>{ctaLabel}</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <Logo />
            <p style="margin-top:12px">{site.tagline}.</p>
            <p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
          </div>
          <div>
            <h2>Tesón</h2>
            <ul>
              <li><a href="/auxiliar-administrativo-estado/">Auxiliar Administrativo del Estado</a></li>
              <li><a href="/herramientas/calculadora-nota-oposiciones/">Calculadora de nota</a></li>
              <li><a href="/metodologia/">Metodología</a></li>
              <li><a href="/impugnaciones/">Impugnaciones</a></li>
              <li><a href="/sobre-teson/">Sobre Tesón</a></li>
              <li><a href="/contacto/">Contacto</a></li>
            </ul>
          </div>
          <div>
            <h2>Legal</h2>
            <ul>
              <li><a href="/aviso-legal/">Aviso legal</a></li>
              <li><a href="/privacidad/">Privacidad</a></li>
              <li><a href="/cookies/">Cookies</a></li>
            </ul>
          </div>
        </div>
        <p class="disclaimer">© {year} Tesón. Tesón es un proyecto independiente: no está vinculado al INAP ni a ninguna Administración Pública. Legislación: fuente Agencia Estatal Boletín Oficial del Estado.</p>
      </div>
    </footer>
  </body>
</html>
